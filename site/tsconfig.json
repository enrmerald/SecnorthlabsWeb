{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    // pbcg/ se importa con extension .ts explicita porque su CLI lo ejecuta
    // Node con type stripping nativo, y Node exige el nombre real del fichero.
    // Solo es admisible con noEmit, que es el caso: aqui no se emite nada.
    "allowImportingTsExtensions": true,
    // Un import olvidado debe romper el build, no quedarse en el bundle.
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // Leer un array de mensajes por indice devuelve T | undefined, que es la
    // verdad: obliga a tratar el caso de la clave que falta en lugar de
    // reventar en produccion (seccion 2.3).
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "out", ".next", ".netlify"]
}
